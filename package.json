{
  "name": "photogenix-ai-studio",
  "version": "2.6.0",
  "description": "Next-gen AI photo studio desktop app with 90% manual work reduction.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node server/index.cjs",
    "dev": "concurrently -n FRONTEND,BACKEND -c auto \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:desktop": "concurrently -n BACKEND,VITE,ELECTRON -c blue,green,yellow \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:3080 && electron .\"",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder --config electron-builder.json5",
    "build:android": "npm run build && npx cap sync android",
    "cap:init": "npx cap add android",
    "cap:open": "npx cap open android",
    "cap:sync": "npx cap sync",
    "start": "node server/index.js",
    "start:desktop": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@google/genai": "^1.33.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4"
  }
}
