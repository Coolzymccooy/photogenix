# Backend-only env (DO NOT expose to browser)
# Create server/.env locally and set:
GEMINI_API_KEY=YOUR_REAL_KEY_HERE

# Optional
PORT=5051
CORS_ORIGIN=http://localhost:3080

# API key for client authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_API_KEY=your_app_api_key_here
